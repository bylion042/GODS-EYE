                </p>

                <div class="spin-area">
                    <img id="character-img" src="/img/lance-spy.png" alt="Lance the Spy" />
                    <p id="character-name">Meet Lance :</p>
                </div>
                
                <p id="spin-count">Bravest Agent Undercover</p>
                
                <div class="controls">
                    <a href="/login"><button id="spin-btn">Access HQ</button></a>
                </div>
                

                <div class="rarity-bar">
                    <span>Elite</span> |
                    <span>Secret</span> |
                    <span>Legendary</span>
                </div>
                
            </div>
        </section>




