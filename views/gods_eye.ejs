<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1f2125">
    <title>God's Eye</title>
    <link rel="icon" href="/uploads/favicon.png" type="image/x-icon">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/gods_eye.css">
</head>

<body>

    <!-- background agents -->
    <div class="background-side-left"></div>
    <div class="background-side-right"></div>

    <div class="container">
        <h1>*** Mail to All Agents</h1>

        <!-- Email Form -->
        <form id="emailForm" action="/send-email" method="POST">
            <input type="text" name="subject" placeholder="Subject" required><br><br>
            <textarea name="message" rows="6" cols="40" placeholder="Your message here..." required></textarea><br><br>
            <button type="submit" class="btn">Send Email</button>
        </form>
    </div>

    <!-- Toastify Notifications -->
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <% if (emailStatus) { %>
        <script>
            const emailStatus = "<%= emailStatus %>";
            Toastify({
                text: emailStatus,
                duration: 3000,
                close: true,
                gravity: "top",
                position: "center",
                backgroundColor: emailStatus.includes('Error')
                    ? "linear-gradient(to right, #ff416c, #ff4b2b)"
                    : "linear-gradient(to right, #00b09b, #96c93d)",
                stopOnFocus: true,
            }).showToast();
        </script>
    <% } %>

</body>

</html>
